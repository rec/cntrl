#!/bin/sh
set -eu
test "$1" = --source-root
test -d "$2/firmware/include/cntrl"
test "$3" = --output
mkdir -p "$4"
test "$TMPDIR" = "$4/tmp"
test "$TMP" = "$TMPDIR"
test "$TEMP" = "$TMPDIR"
temporary_file=$(mktemp "$TMPDIR/build.XXXXXX")
printf '%s\n' 'temporary build data' > "$temporary_file"
printf '%s\n' "$temporary_file" > "$4/temporary-path.txt"
printf '%s\n' "image = 'firmware.bin'" "target = 'target.toml'" > "$4/build.toml"
printf '%s\n' 'test image' > "$4/firmware.bin"
printf '%s\n' "buttons = ['one']" > "$4/target.toml"

--- a/libraries/FlexIO_t4/src/FlexSerial.cpp
+++ b/libraries/FlexIO_t4/src/FlexSerial.cpp
@@ -312,6 +312,15 @@
 void FlexSerial::end(void) {
     // If the transmit was allocated free it now as well as timers and shifters.
     if (_tx_pflex) {
+        IMXRT_FLEXIO_t &p = _tx_pflex->port();
+        if (_tx_shifter < 8) {
+            p.SHIFTSIEN &= ~(1u << _tx_shifter);
+            p.SHIFTCTL[_tx_shifter] = 0;
+        }
+        if (_tx_timer < 8) {
+            p.TIMIEN &= ~(1u << _tx_timer);
+            p.TIMCTL[_tx_timer] = 0;
+        }
         _tx_pflex->freeTimers(_tx_timer);
         _tx_timer = 0xff;
         _tx_pflex->freeShifter(_tx_shifter);
